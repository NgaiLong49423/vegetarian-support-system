        <object id="tbl_32" label="USER" pk_constraint="PK_USER (user_id)" unique_constraints="UQ_USER_email (email); UQ_USER_email_verification_token (email_verification_token) WHERE ([email_verification_token] IS NOT NULL); UQ_USER_google_subject (google_subject) WHERE ([google_subject] IS NOT NULL); UQ_USER_password_reset_token (password_reset_token) WHERE ([password_reset_token] IS NOT NULL)" check_constraints="CK_USER_account_status: ([account_status]='LOCKED' OR [account_status]='ACTIVE'); CK_USER_activity_level: ([activity_level]='VERY_ACTIVE' OR [activity_level]='MODERATELY_ACTIVE' OR [activity_level]='LIGHTLY_ACTIVE' OR [activity_level]='SEDENTARY'); CK_USER_biological_sex: ([biological_sex]='FEMALE' OR [biological_sex]='MALE'); CK_USER_date_of_birth: ([date_of_birth]&gt;='1900-01-01' AND [date_of_birth]&lt;=CONVERT([date],getdate())); CK_USER_failed_login_attempts_non_negative: ([failed_login_attempts]&gt;=(0)); CK_USER_health_data_consent_timestamp: ([health_data_consent]=(0) AND [health_data_consent_at] IS NULL OR [health_data_consent]=(1) AND [health_data_consent_at] IS NOT NULL); CK_USER_height_cm: ([height_cm]&gt;=(100.0) AND [height_cm]&lt;=(250.0)); CK_USER_nutrition_eligibility_status: ([nutrition_eligibility_status]='INELIGIBLE' OR [nutrition_eligibility_status]='ELIGIBLE' OR [nutrition_eligibility_status]='NOT_CONFIRMED'); CK_USER_nutrition_eligibility_timestamp: ([nutrition_eligibility_status]='NOT_CONFIRMED' AND [nutrition_eligibility_confirmed_at] IS NULL OR ([nutrition_eligibility_status]='INELIGIBLE' OR [nutrition_eligibility_status]='ELIGIBLE') AND [nutrition_eligibility_confirmed_at] IS NOT NULL); CK_USER_nutrition_goal: ([nutrition_goal] IS NULL OR ([nutrition_goal]='SUPPORT_TRAINING' OR [nutrition_goal]='IMPROVE_HEALTH' OR [nutrition_goal]='BUILD_MUSCLE' OR [nutrition_goal]='GAIN_WEIGHT' OR [nutrition_goal]='LOSE_WEIGHT' OR [nutrition_goal]='MAINTAIN_WEIGHT')); CK_USER_onboarding_status: ([onboarding_status]='COMPLETED' OR [onboarding_status]='SKIPPED' OR [onboarding_status]='NOT_STARTED'); CK_USER_password_reset_token_pair: ([password_reset_token] IS NULL AND [reset_token_expires_at] IS NULL OR [password_reset_token] IS NOT NULL AND [reset_token_expires_at] IS NOT NULL); CK_USER_password_reset_window_count_non_negative: ([password_reset_window_count]&gt;=(0)); CK_USER_preferred_difficulty: ([preferred_difficulty]='HARD' OR [preferred_difficulty]='MEDIUM' OR [preferred_difficulty]='EASY'); CK_USER_role: ([role]='ADMIN' OR [role]='EXPERT' OR [role]='CUSTOMER'); CK_USER_vegetarian_type: ([vegetarian_type]='LACTO_OVO' OR [vegetarian_type]='OVO' OR [vegetarian_type]='LACTO' OR [vegetarian_type]='VEGAN'); CK_USER_verification_token_pair: ([email_verification_token] IS NULL AND [verification_token_expires_at] IS NULL OR [email_verification_token] IS NOT NULL AND [verification_token_expires_at] IS NOT NULL); CK_USER_weight_kg: ([weight_kg]&gt;=(30.0) AND [weight_kg]&lt;=(300.0))" default_constraints="role: DF_USER_role=('CUSTOMER'); account_status: DF_USER_account_status=('ACTIVE'); email_verified: DF_USER_email_verified=((0)); pregnant: DF_USER_pregnant=((0)); breastfeeding: DF_USER_breastfeeding=((0)); therapeutic_diet_required: DF_USER_therapeutic=((0)); nutrition_scope_confirmed: DF_USER_nutrition_scope=((0)); reply_email_enabled: DF_USER_reply_email=((1)); onboarding_status: DF_USER_onboarding_status=('NOT_STARTED'); avoid_none_confirmed: DF_USER_avoid_none_confirmed=((0)); dislike_none_confirmed: DF_USER_dislike_none_confirmed=((0)); created_at: DF_USER_created_at=(sysutcdatetime()); updated_at: DF_USER_updated_at=(sysutcdatetime()); health_data_consent: DF_USER_health_data_consent=((0)); failed_login_attempts: DF_USER_failed_login_attempts=((0)); nutrition_eligibility_status: DF_USER_nutrition_eligibility_status=('NOT_CONFIRMED'); password_reset_window_count: DF_USER_password_reset_window_count=((0))">
