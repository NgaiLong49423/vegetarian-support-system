        <object id="tbl_33" label="USER_ACCOUNT_AUDIT" pk_constraint="PK_USER_ACCOUNT_AUDIT (user_account_audit_id)" unique_constraints="" check_constraints="CK_USER_ACCOUNT_AUDIT_ACTION: ([action]='AI_PACKAGE_GIFTED' OR [action]='ROLE_CHANGED' OR [action]='STATUS_CHANGED'); CK_USER_ACCOUNT_AUDIT_REASON: (len(ltrim(rtrim([reason])))&gt;=(10) AND len(ltrim(rtrim([reason])))&lt;=(500)); CK_USER_ACCOUNT_AUDIT_VALUES: ([action]='STATUS_CHANGED' AND [old_account_status] IS NOT NULL AND ([old_account_status]='LOCKED' OR [old_account_status]='ACTIVE') AND [new_account_status] IS NOT NULL AND ([new_account_status]='LOCKED' OR [new_account_status]='ACTIVE') AND [old_role] IS NULL AND [new_role] IS NULL AND [old_tier] IS NULL AND [new_tier] IS NULL AND [expert_application_id] IS NULL OR [action]='ROLE_CHANGED' AND [old_role] IS NOT NULL AND ([old_role]='EXPERT' OR [old_role]='CUSTOMER') AND [new_role] IS NOT NULL AND ([new_role]='EXPERT' OR [new_role]='CUSTOMER') AND [old_account_status] IS NULL AND [new_account_status] IS NULL AND [old_tier] IS NULL AND [new_tier] IS NULL OR [action]='AI_PACKAGE_GIFTED' AND [old_tier] IS NOT NULL AND ([old_tier]='PRO' OR [old_tier]='PLUS' OR [old_tier]='FREE') AND [new_tier] IS NOT NULL AND ([new_tier]='PRO' OR [new_tier]='PLUS' OR [new_tier]='FREE') AND ([new_tier]='FREE' AND [new_tier_ends_at] IS NULL OR ([new_tier]='PRO' OR [new_tier]='PLUS') AND [new_tier_ends_at] IS NOT NULL) AND [old_role] IS NULL AND [new_role] IS NULL AND [old_account_status] IS NULL AND [new_account_status] IS NULL AND [expert_application_id] IS NULL)" default_constraints="">
