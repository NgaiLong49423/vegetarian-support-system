# Copy to .env.local (ignored by Git) and adjust per environment.
# Base URL for the Backend API. Vite proxies /api to localhost:8080 in direct development;
# Docker Compose overrides the proxy target with the backend service. Never put secrets here.
VITE_API_BASE_URL=/api/v1
# Google OAuth client ID for "Continue with Google" (public, same value as the Backend MAMXANH_GOOGLE_CLIENT_ID).
# Leave empty to hide Google sign-in. The Google Cloud client must list this app's origin, e.g. http://localhost:5173.
VITE_GOOGLE_CLIENT_ID=
