{
  "extends": "@istanbuljs/nyc-config-typescript",
  "all": true,
  "include": ["src/**/*.{ts,tsx,js,jsx}"],
  "exclude": [
    "**/*.d.ts",
    "**/*.stories.{ts,tsx,js,jsx}",
    "tests/**",
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**"
  ],
  "extension": [".ts", ".tsx", ".js", ".jsx"],
  "reporter": ["text-summary", "html", "lcov"],
  "report-dir": "coverage",
  "temp-dir": ".nyc_output",
  "check-coverage": true,
  "lines": 60,
  "statements": 60,
  "functions": 60,
  "branches": 60
}
