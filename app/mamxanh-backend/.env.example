# Backend local runtime configuration. Copy values into .env; never commit real values.
SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=MamXanhDB;encrypt=true;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=YOUR_LOCAL_DB_USERNAME
SPRING_DATASOURCE_PASSWORD=YOUR_LOCAL_DB_PASSWORD

# Required by the repository Docker Compose SQL Server. Replace with a strong local-only value.
MSSQL_SA_PASSWORD=CHANGE_THIS_LOCAL_SQLSERVER_PASSWORD

# Frontend origin used in email verification links, and the CORS allowlist (comma-separated, no wildcard).
MAMXANH_FRONTEND_BASE_URL=http://localhost:5173
MAMXANH_CORS_ALLOWED_ORIGINS=http://localhost:5173

# HS256 signing secret for access tokens, at least 32 bytes; the Backend refuses to start without it.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
MAMXANH_JWT_SECRET=

# Local-only password shared by seeded demo accounts (12-72 UTF-8 bytes); never commit the real value.
MAMXANH_DEMO_PASSWORD=
# Google login (FR-03-D): OAuth client ID from Google Cloud Console (public, not a secret). Use the same value as
# the Frontend VITE_GOOGLE_CLIENT_ID. Leave empty to disable Google login.
MAMXANH_GOOGLE_CLIENT_ID=

# Google Gemini API key for Backend AI integrations. Never commit a real key.
GEMINI_API_KEY=

# Brevo SMTP for real emails (shared dev values are in the team password vault).
# Keep SPRING_MAIL_HOST empty to run without sending email; set it to smtp-relay.brevo.com to send.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=YOUR_BREVO_SMTP_LOGIN
SPRING_MAIL_PASSWORD=YOUR_BREVO_SMTP_KEY
MAMXANH_MAIL_FROM=YOUR_VERIFIED_SENDER_ADDRESS

# payOS Payment Gateway (leave empty or use sandbox credentials from payOS dashboard)
MAMXANH_PAYOS_CLIENT_ID=
MAMXANH_PAYOS_API_KEY=
MAMXANH_PAYOS_CHECKSUM_KEY=
MAMXANH_PAYOS_ENDPOINT=https://api-merchant.payos.vn
MAMXANH_PAYOS_RETURN_URL=http://localhost:5173/payment/success
MAMXANH_PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel

# Azure Blob Storage for recipe images (FR-14, AC-14.1..AC-14.4)
# Empty/unavailable storage rejects image uploads with 503; other features remain available.
# Use a container whose public Blob read access is enabled for published recipe images.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=mamxanh-recipes
